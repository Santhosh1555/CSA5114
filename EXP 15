#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char cipher[200], plain[200];
    int top, key, i;

    printf("Enter Cipher Text (UPPERCASE): ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("Enter number of possible plaintexts to display: ");
    scanf("%d", &top);

    if(top > 26)
        top = 26;

    printf("\nPossible Plaintexts:\n\n");

    for(key = 0; key < top; key++)
    {
        printf("Key %2d : ", key);

        for(i = 0; cipher[i] != '\0'; i++)
        {
            if(isupper(cipher[i]))
                plain[i] = ((cipher[i] - 'A' - key + 26) % 26) + 'A';
            else if(islower(cipher[i]))
                plain[i] = ((cipher[i] - 'a' - key + 26) % 26) + 'a';
            else
                plain[i] = cipher[i];
        }

        plain[i] = '\0';
        printf("%s", plain);
    }

    return 0;
}
