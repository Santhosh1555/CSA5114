#include <stdio.h>
#include <math.h>

int main()
{
    long double fact = 1.0;
    int i;

    // Calculate 25!
    for(i = 1; i <= 25; i++)
    {
        fact *= i;
    }

    printf("Playfair Cipher Key Space\n");
    printf("-------------------------\n");

    printf("Total possible keys (25!)      = %.0Lf\n", fact);
    printf("Approximate value              = %.3Le\n", fact);
    printf("Approximate power of 2         = 2^84\n\n");

    printf("Considering equivalent keys:\n");
    printf("Effectively unique keys = 25! / 2\n");
    printf("Approximate value       = 7.756 x 10^24\n");
    printf("Approximate power of 2  = 2^83\n");

    return 0;
}
