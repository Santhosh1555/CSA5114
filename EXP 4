#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[100];
    int i, j = 0;

    printf("Enter Plain Text: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter Key: ");
    scanf("%s", key);

    int keyLen = strlen(key);

    printf("\nCipher Text: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            char ch = toupper(text[i]);
            char k = toupper(key[j % keyLen]);

            ch = ((ch - 'A') + (k - 'A')) % 26 + 'A';
            printf("%c", ch);

            j++;
        }
        else
        {
            printf("%c", text[i]);
        }
    }

    return 0;
}
