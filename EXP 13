#include <stdio.h>

int main()
{
    // Known Plaintext Matrix
    int P[2][2] = {
        {7, 4},    // H E
        {11, 15}   // L P
    };

    // Corresponding Ciphertext Matrix
    int C[2][2] = {
        {1, 19},   // B T
        {2, 5}     // C F
    };

    printf("Known Plaintext Matrix (P):\n");
    printf("%2d %2d\n", P[0][0], P[0][1]);
    printf("%2d %2d\n\n", P[1][0], P[1][1]);

    printf("Known Ciphertext Matrix (C):\n");
    printf("%2d %2d\n", C[0][0], C[0][1]);
    printf("%2d %2d\n\n", C[1][0], C[1][1]);

    printf("Hill Cipher is vulnerable to a Known Plaintext Attack.\n");
    printf("Using sufficient plaintext-ciphertext pairs,\n");
    printf("the encryption key can be recovered.\n\n");

    printf("Formula:\n");
    printf("K = C * P^-1 (mod 26)\n");

    return 0;
}
