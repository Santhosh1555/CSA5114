#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

// Generate Playfair Matrix
void generateMatrix(char key[])
{
    int used[26] = {0};
    int i, j, k = 0;

    used['J' - 'A'] = 1; // Treat I and J as same

    for(i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);
        if(ch == 'J')
            ch = 'I';

        if(ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for(i = 0; i < 26; i++)
    {
        if(!used[i])
        {
            matrix[k / 5][k % 5] = i + 'A';
            k++;
        }
    }
}

// Find position of a character
void findPosition(char ch, int *row, int *col)
{
    if(ch == 'J')
        ch = 'I';

    for(int i = 0; i < 5; i++)
    {
        for(int j = 0; j < 5; j++)
        {
            if(matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char key[50], text[100];
    char plain[200], cipher[200];
    int i, j = 0;

    printf("Enter Keyword: ");
    scanf("%s", key);

    getchar();

    printf("Enter Plain Text: ");
    fgets(text, sizeof(text), stdin);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    // Prepare plaintext
    j = 0;
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            plain[j] = toupper(text[i]);
            if(plain[j] == 'J')
                plain[j] = 'I';
            j++;
        }
    }
    plain[j] = '\0';

    // Create digraphs
    char temp[200];
    int k = 0;

    for(i = 0; i < j; i++)
    {
        temp[k++] = plain[i];

        if(i == j - 1)
            temp[k++] = 'X';
        else if(plain[i] == plain[i + 1])
            temp[k++] = 'X';
        else
            temp[k++] = plain[++i];
    }

    temp[k] = '\0';

    // Encryption
    int index = 0;

    for(i = 0; i < k; i += 2)
    {
        int r1, c1, r2, c2;

        findPosition(temp[i], &r1, &c1);
        findPosition(temp[i + 1], &r2, &c2);

        if(r1 == r2)
        {
            cipher[index++] = matrix[r1][(c1 + 1) % 5];
            cipher[index++] = matrix[r2][(c2 + 1) % 5];
        }
        else if(c1 == c2)
        {
            cipher[index++] = matrix[(r1 + 1) % 5][c1];
            cipher[index++] = matrix[(r2 + 1) % 5][c2];
        }
        else
        {
            cipher[index++] = matrix[r1][c2];
            cipher[index++] = matrix[r2][c1];
        }
    }

    cipher[index] = '\0';

    printf("\nProcessed Plain Text : %s\n", temp);
    printf("Cipher Text          : %s\n", cipher);

    return 0;
}
