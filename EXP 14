#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main()
{
    char plaintext[100], ciphertext[100];
    int key[100];
    int i, len;

    printf("Enter Plain Text (uppercase): ");
    scanf("%s", plaintext);

    len = strlen(plaintext);

    printf("Enter %d key values (0-25):\n", len);
    for(i = 0; i < len; i++)
    {
        scanf("%d", &key[i]);
    }

    // Encryption
    for(i = 0; i < len; i++)
    {
        if(isalpha(plaintext[i]))
        {
            ciphertext[i] = ((plaintext[i] - 'A' + key[i]) % 26) + 'A';
        }
        else
        {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[len] = '\0';

    printf("\nPlain Text : %s\n", plaintext);

    printf("Key        : ");
    for(i = 0; i < len; i++)
        printf("%d ", key[i]);

    printf("\nCipher Text: %s\n", ciphertext);

    return 0;
}
