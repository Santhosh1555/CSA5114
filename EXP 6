#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char cipher[100];
    int a = 3;
    int b = 15;
    int a_inv = 9;
    int i, c, p;

    printf("Enter Cipher Text (UPPERCASE): ");
    scanf("%s", cipher);

    printf("Plain Text: ");

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha(cipher[i]))
        {
            c = cipher[i] - 'A';
            p = (a_inv * (c - b + 26)) % 26;
            printf("%c", p + 'A');
        }
        else
        {
            printf("%c", cipher[i]);
        }
    }

    printf("\n");

    return 0;
}
