#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main()
{
    char text[100];
    int key, i;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key (1-25): ");
    scanf("%d", &key);

    if(key < 1 || key > 25)
    {
        printf("Invalid key! Enter a value between 1 and 25.\n");
        return 0;
    }

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isupper(text[i]))
        {
            text[i] = ((text[i] - 'A' + key) % 26) + 'A';
        }
        else if(islower(text[i]))
        {
            text[i] = ((text[i] - 'a' + key) % 26) + 'a';
        }
    }

    printf("\nCipher Text: %s", text);

    return 0;
}
